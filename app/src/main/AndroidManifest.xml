<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NothingAndroidSDKDemo">

        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NothingAndroidSDKDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UltimateSettingsActivity"
            android:exported="false"
            android:label="Ultimate Key Settings"
            android:theme="@style/Theme.NothingAndroidSDKDemo" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false"
            android:label="@string/about_app"
            android:theme="@style/Theme.NothingAndroidSDKDemo" />

        <activity
            android:name=".GlyphMatrixWidgetConfigureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AodSettingsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aod_widget_info" />
        </receiver>

        <receiver
            android:name=".GlyphMatrixWidget1x1"
            android:exported="true"
            android:label="Glyph Matrix 1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.danissimo.glyphgeekbox.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glyph_matrix_widget_1x1_info" />
        </receiver>

        <receiver
            android:name=".GlyphMatrixWidget2x2"
            android:exported="true"
            android:label="Glyph Matrix 2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.danissimo.glyphgeekbox.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glyph_matrix_widget_2x2_info" />
        </receiver>

        <service
            android:name=".EssentialKeyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".demos.animation.AnimationDemoService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_animation" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/animation_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_animation" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>

        <service
            android:name=".aod.ChargeService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_charge" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/charge_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_charge" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>

        <service
            android:name=".aod.StatusBarService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_status_bar" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/statusbar_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_status_bar" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>

        <service
            android:name=".aod.ScrollingTextService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_scrolling_text" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/scrolling_text_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_scrolling_text" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>

        <service
            android:name=".aod.AnalogClockService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_analog_clock" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/clock_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_analog_clock" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>



        <!-- Animation Ultimate Key Service -->
        <service
            android:name=".demos.UltimateKeyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name_ultimate_key" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/ultimate_essential_thumbnail" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary_ultimate_key" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1"/>
        </service>

    </application>

</manifest>